#!/usr/bin/env bash
# ccompile — batch compile C files with chronic-style output
#
# WHAT IT DOES
# Compiles multiple C files, showing progress and suppressing output on
# success. Failed compilations print full diagnostics. Per-file compiler
# flags can be embedded on line 1 (shebang or comment).
#
# HOW IT WORKS
# 1. Parse CLI options for output directory/file
# 2. For each source file, extract flags from line 1 (shebang or comment)
# 3. Compile via $CC, capturing stdout/stderr
# 4. On success: silent. On failure: print diagnostics
#
# USAGE
#   ccompile [-d DIR] [-o FILE] [-v] FILE.c...
#
# OPTIONS
#   -d DIR   Output directory (default: same as source)
#   -o FILE  Output filename (single file only)
#   -v       Show full compiler command
#
# PER-FILE FLAGS
#   #!/usr/bin/env -S ccraft -lm
#   #!/usr/bin/env -S ccraft -p SDL2 -O2
#   // ccompile -lm -DDEBUG
#   /* ccompile -lm -DDEBUG */
#
# EXAMPLES
#   ccompile *.c                    # compile all, binaries next to sources
#   ccompile -d bin *.c             # compile all into bin/
#   ccompile -o myprog main.c       # single file, custom output name
#   ccompile -v -d build src/*.c    # verbose, see full compiler commands
#
# EXIT CODES
#   0   All files compiled successfully
#   1   Any file failed to compile, or usage error
#
# ENVIRONMENT
#   CC        Compiler (default: cc)
#   CFLAGS    Compiler flags (default: -O2 -Wall -Wextra)
#   LDFLAGS   Linker flags (default: none)
#   STD_FLAG  C standard (default: -std=gnu99)
#
# DEPENDENCIES
#   cc, or $CC
#   pkg-config, if -p used
#   nugget, if -R used

set -eu

CC=${CC:-cc}
CFLAGS=${CFLAGS:--O2 -Wall -Wextra}

# ============================================================================
# Helpers
# ============================================================================

die()   { echo "ccompile: $*" >&2; exit 1; }
usage() { die "Usage: ccompile [-d DIR] [-o FILE] [-v] FILE.c..."; }
no()    { [[ -z $1 ]]; }
got()   { [[ -n $1 ]]; }

# ============================================================================
# Predicates
# ============================================================================

has_arguments()    { [[ $# -gt 0 ]]; }
is_single()        { [[ $# -eq 1 ]]; }
is_verbose()       { [[ -n ${VERBOSE:-} ]]; }
succeeded()        { [[ $1 -eq 0 ]]; }
is_elf()           { file -b "$1" 2>/dev/null | grep -q '^ELF '; }
has_remote_deps()  { [[ -n ${REMOTE_DEPS:-} ]]; }
safe_to_overwrite(){ ! [[ -e $1 ]] || is_elf "$1"; }

# ============================================================================
# Output path resolution
# ============================================================================

output_path() {
    local SRC=$1 OUTDIR=$2 OUTFILE=$3

    if got "$OUTFILE"; then echo "$OUTFILE"; return; fi
    if got "$OUTDIR"; then echo "$OUTDIR/$(basename "${SRC%.c}")"; return; fi
    echo "${SRC%.c}"
}

# ============================================================================
# Annotation parsing — extract flags from shebang and // comments
# ============================================================================

parse_flags() {
    local LINE

    CFLAGS_SHEBANG=""
    LDFLAGS_SHEBANG=""
    STD_FLAG=${STD_FLAG:--std=gnu99}
    REMOTE_DEPS=""

    while IFS= read -r LINE; do
        case $LINE in
            '#!'*ccraft*)
                expand_quoted "${LINE#*ccraft}" ;;
            '// ccraft '*)
                expand_quoted "${LINE#*ccraft }" ;;
            '/* ccraft '*)
                local BODY=${LINE#*ccraft }; BODY=${BODY%\*/}
                expand_quoted "$BODY" ;;
            '// ccompile '*)
                expand_quoted "${LINE#*ccompile }" ;;
            '/* ccompile '*)
                local BODY=${LINE#*ccompile }; BODY=${BODY%\*/}
                expand_quoted "$BODY" ;;
            '//'*)  ;;
            '/*'*)  break ;;
            *)      break ;;
        esac
    done < "$1"
}

expand_quoted() {
    eval "set -- $1"
    expand_flags "$@"
}

expand_flags() {
    while [[ $# -gt 0 ]]; do
        CONSUMED=1
        case $1 in
            -p)  CFLAGS_SHEBANG="$CFLAGS_SHEBANG $(pkg-config --cflags "$2" 2>/dev/null)" || die "pkg-config: $2"
                 LDFLAGS_SHEBANG="$LDFLAGS_SHEBANG $(pkg-config --libs   "$2" 2>/dev/null)" || die "pkg-config: $2"
                 CONSUMED=2 ;;
            -p*) CFLAGS_SHEBANG="$CFLAGS_SHEBANG $(pkg-config --cflags "${1#-p}" 2>/dev/null)" || die "pkg-config: ${1#-p}"
                 LDFLAGS_SHEBANG="$LDFLAGS_SHEBANG $(pkg-config --libs   "${1#-p}" 2>/dev/null)" || die "pkg-config: ${1#-p}" ;;
            -l*) LDFLAGS_SHEBANG="$LDFLAGS_SHEBANG $1" ;;
            -I)  CFLAGS_SHEBANG="$CFLAGS_SHEBANG -I$2"; CONSUMED=2 ;;
            -I*) CFLAGS_SHEBANG="$CFLAGS_SHEBANG $1" ;;
            -R)  REMOTE_DEPS="$REMOTE_DEPS $2"; CONSUMED=2 ;;
            -R*) REMOTE_DEPS="$REMOTE_DEPS ${1#-R}" ;;
            -std=*) STD_FLAG=$1 ;;
            -v|-vv) ;;     # verbosity, not a compiler flag
            -o)  CONSUMED=2 ;;  # ccompile controls output path
            -o*) ;;             # -oFILE form
            *)   CFLAGS_SHEBANG="$CFLAGS_SHEBANG $1" ;;
        esac
        shift $CONSUMED
    done
}

# ============================================================================
# Remote dependencies — fetch header-only libraries via nugget
# ============================================================================

fetch_remote_dep() {
    local URL=$1
    local NUGGET

    NUGGET=$(command -v nugget) || {
        NUGGET="${TMPDIR}/nugget-tool"

        [[ -x $NUGGET ]] || {
            command -v curl >/dev/null 2>&1 || die "curl required to download nugget"
            curl -fsSL -o "$NUGGET" \
                https://raw.githubusercontent.com/snoozelot/denim/master/screws/nugget
            chmod +x "$NUGGET"
        }
    }

    mkdir -p "$NUGGET_DIR"
    "$NUGGET" -o "$NUGGET_DIR" "$URL" >/dev/null 2>&1 || die "nugget: $URL"
}

# ============================================================================
# Compilation
# ============================================================================

# SRC is from the caller's scope (bash dynamic scope).
# Used by report_failure to label which file failed.
report_failure() {
    echo "=== FAILED: $SRC ===" >&2
    cat "$TMPDIR/out"
    cat "$TMPDIR/err" >&2
}

compile() {
    local SRC=$1
    local OUT=$2
    local RC
    local SRCDIR
    local CC_ALL
    local LD_ALL

    safe_to_overwrite "$OUT" || die "refusing to overwrite non-ELF: $OUT"

    parse_flags "$SRC"
    RC=0

    if has_remote_deps; then
        NUGGET_DIR="$TMPDIR/nugget"
        mkdir -p "$NUGGET_DIR"

        for URL in $REMOTE_DEPS; do
            fetch_remote_dep "$URL"
        done
    fi

    SRCDIR=$(dirname "$(readlink -f "$SRC" 2>/dev/null || echo "$SRC")")

    CC_ALL="$STD_FLAG -I$SRCDIR $CFLAGS $CFLAGS_SHEBANG"
    if has_remote_deps; then CC_ALL="$CC_ALL -I$TMPDIR"; fi

    LD_ALL="$LDFLAGS_SHEBANG ${LDFLAGS:-}"

    if is_verbose; then echo "$CC $CC_ALL -o $OUT $SRC $LD_ALL" >&2; fi

    sed "1 s|^#!.*|#line 2 \"$SRC\"|" "$SRC" > "$TMPDIR/src.c"
    $CC $CC_ALL -o "$OUT" "$TMPDIR/src.c" $LD_ALL >"$TMPDIR/out" 2>"$TMPDIR/err" || RC=$?

    succeeded "$RC" || report_failure
    return $RC
}

compile_all() {
    local OUTDIR=$1
    local OUTFILE=$2
    shift 2
    local TOTAL=$#
    local N=0
    local FAIL=0
    local SRC
    local OUT

    for SRC in "$@"; do
        N=$((N + 1))
        OUT=$(output_path "$SRC" "$OUTDIR" "$OUTFILE")
        echo "[$N/$TOTAL] $CC $SRC -o $OUT"
        compile "$SRC" "$OUT" || FAIL=1
    done

    return $FAIL
}

# ============================================================================
# Main
# ============================================================================

main() {
    local OUTDIR=""
    local OUTFILE=""
    local VERBOSE=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            -d) OUTDIR=$2; shift 2 ;;
            -o) OUTFILE=$2; shift 2 ;;
            -v) VERBOSE=1; shift ;;
            -h|--help) usage ;;
            -*) die "unknown option: $1" ;;
            *) break ;;
        esac
    done

    has_arguments "$@" || usage

    if got "$OUTFILE" && ! is_single "$@"; then
        die "-o invalid with multiple files"
    fi

    TMPDIR=$(mktemp -d)
    trap 'rm -rf "$TMPDIR"' EXIT INT TERM HUP

    compile_all "$OUTDIR" "$OUTFILE" "$@"
}

main "$@"
