#!/usr/bin/env bash
# goo — run Go files as scripts
#
# Compiles a .go file with // go get and -p/-I deps.
# Creates ephemeral module, caches binary in /tmp/.
# Shebang: ./script.go works. No go.mod needed.
#
# WHY
# go run rebuilds every run and ignores // go get.
# goo caches and resolves inline deps.
#
# USAGE
#   goo [-v|-vv] [-p PKG...] [-I DIR...] FILE.go [ARG...]
#   cat file.go | goo /dev/stdin
#   #!/usr/bin/env -S goo
#
# OPTIONS
#   -v        Show build commands
#   -vv       Also show source (rebuild only)
#   -p PKG    Download package, e.g. -p rsc.io/quote@v1.5.2
#   -I DIR    Include local Go packages. Subdirs with .go files
#             become importable as goo/PACKAGE. Source dir auto-included.
#             DIR is relative to CWD.
#   -h        This help
#
# ENVIRONMENT
#   GO        Go toolchain (default: go)
#   GOO_CACHE mtime (default: source newer than binary),
#             md5 (content hash), none (always rebuild)
#   TMPDIR    Temp dir (default: /tmp)
#
# EXAMPLES
#   goo hello.go
#   goo -v hello.go
#   goo -p rsc.io/quote@v1.5.2 hello.go
#   goo -I ../lib script.go
#   cat script.go | goo /dev/stdin
#
# DEPENDENCIES
#   go (or $GO)

set -e

SCRIPT=${0##*/}
die() { echo "$SCRIPT: $*" >&2; exit 1; }
in_dir() ( DIR=$1; shift; cd "$DIR" && "$@" )
has_binary() { [[ -x "$OUT" ]]; }
has_deps()   { grep -q '^// go get ' "$TARGET" 2>/dev/null || [[ ${#GO_GET_DEPS[@]} -gt 0 ]]; }
is_verbose()    { (( V_FLAG >= 1 )); }
is_very_verbose(){ (( V_FLAG >= 2 )); }

trace()   { if is_verbose; then set -x; "$@"; { set +x; } 2>/dev/null; else "$@"; fi; }
cleanup() { rm -rf -- "${CLEANUP[@]}"; }

quiet() {
    if is_verbose; then trace "$@"; else
        local CAPTURED STATUS
        CAPTURED=$("$@" 2>&1); STATUS=$?
        if (( STATUS != 0 )); then echo "+ $*" >&2; echo "$CAPTURED" >&2; fi
        return "$STATUS"
    fi
}

# Cache key: md5 hashes content, mtime/none hashes path. Deps + includes included.
cache_key() {
    case ${CACHE_MODE:=mtime} in
        md5)
            { id -u; cat "$TARGET"
              for s in "${GO_GET_DEPS[@]}"; do echo "$s"; done
              for d in "${INCLUDE_DIRS[@]}"; do find "$d" -name '*.go' -exec cat {} +; done
            } ;;
        *)
            { id -u; readlink -f "$TARGET"
              for s in "${GO_GET_DEPS[@]}"; do echo "$s"; done
              for d in "${INCLUDE_DIRS[@]}"; do echo "$d"; done
            } ;;
    esac | md5sum | head -c8
}

needs_rebuild() {
    if ! has_binary; then return 0; fi
    case $CACHE_MODE in
        none)  return 0 ;;
        mtime) [[ "$TARGET" -nt "$OUT" ]] && return 0
               for d in "${INCLUDE_DIRS[@]}"; do
                   find "$d" -name '*.go' -newer "$OUT" -print -quit 2>/dev/null | grep -q . && return 0
               done
               return 1 ;;
        md5)   [[ $(cache_key) != "$SCOPE_ID" ]] ;;
    esac
}

# Read stdin into temp file for compilation.
capture_stdin() {
    TARGET=$(mktemp /tmp/goo-XXXXX.go)
    CLEANUP+=("$TARGET"); trap cleanup EXIT
    cat > "$TARGET"
    [[ -s "$TARGET" ]] || die "stdin empty"
}

# Strip shebang, copy to module dir, show source if -vv.
prepare_source() {
    sed '1s|#!|//|' < "$TARGET" > "$1/main.go"
    if is_very_verbose; then
        bat --language=go --number --paging=never "$1/main.go" 1>&2 2>/dev/null ||
        cat -n "$1/main.go" 1>&2
    fi
}

# Symlink Go packages from include dirs into the build module root.
# Each subdirectory containing .go files becomes importable as goo/SUBDIR.
link_includes() {
    local DIR=$1; shift
    local inc subdir
    for inc in "$@"; do
        [[ -d "$inc" ]] || continue
        for subdir in "$inc"/*/; do
            [[ -d "$subdir" ]] || continue
            ls "$subdir"*.go &>/dev/null || continue
            ln -sfn "$subdir" "$DIR/$(basename "$subdir")"
        done
    done
}

# Resolve // go get and -p deps in the build directory.
resolve_deps() {
    while IFS= read -r LINE; do
        in_dir "$1" quiet "${GO-go}" get "${LINE#// go get }"
    done < <(grep '^// go get ' "$TARGET" || :)
    for SPEC in "${GO_GET_DEPS[@]}"; do
        in_dir "$1" quiet "${GO-go}" get "$SPEC"
    done
}

# Build script: temp module, deps, includes, compile to $OUT.
build_script() {
    local DIR
    DIR=$(mktemp -d /tmp/goo-XXXXX)
    CLEANUP+=("$DIR"); trap cleanup EXIT

    prepare_source "$DIR"
    link_includes "$DIR" "${INCLUDE_DIRS[@]}"
    in_dir "$DIR" quiet "${GO-go}" mod init goo 2>/dev/null
    if has_deps; then resolve_deps "$DIR"; fi
    in_dir "$DIR" trace "${GO-go}" build -buildvcs=false -o "$OUT" .
}

# Execute compiled binary with program args.
# xtrace re-enabled if verbose so exec/exit are visible.
# errexit off — exec returns binary's status, set -e hides xtrace of exit.
exec_binary() {
    { set +x; } 2>/dev/null
    if is_verbose; then set -x; fi
    { set +e; } 2>/dev/null

    (exec -a "$TARGET" "$OUT" "$@")
    exit $?
}

# ============================================================================
main() {
    local TARGET GO_GET_DEPS CLEANUP V_FLAG CACHE_MODE SCOPE_ID OUT INCLUDE_DIRS

    V_FLAG=0; GO_GET_DEPS=(); CLEANUP=(); INCLUDE_DIRS=()
    CACHE_MODE=${GOO_CACHE:-mtime}

    while [[ ${1:-} == -* ]]; do
        case $1 in
            -v)   ((V_FLAG+=1)); shift ;;
            -vv)  ((V_FLAG+=2)); shift ;;
            -p)   GO_GET_DEPS+=("$2"); shift 2 ;;
            -p*)  GO_GET_DEPS+=("${1#-p}"); shift ;;
            -I)   INCLUDE_DIRS+=("$2"); shift 2 ;;
            -I*)  INCLUDE_DIRS+=("${1#-I}"); shift ;;
            -h|--help) sed -n '2,/^[^#]/ { s/^# \?//p }' "$0"; exit 0 ;;
            *)    break ;;
        esac
    done

    TARGET=$1; shift 2>/dev/null || :

    if [[ $TARGET == /dev/stdin ]]; then capture_stdin; fi
    [[ -f "$TARGET" ]] || die "usage: $SCRIPT [-v|-vv] [-p PKG...] [-I DIR...] FILE.go [ARG...]"

    # Auto-include source file's directory, then explicit -I dirs
    INCLUDE_DIRS=("$(dirname "$(readlink -f "$TARGET")")" "${INCLUDE_DIRS[@]}")

    SCOPE_ID=$(cache_key)
    OUT=/tmp/goo-${SCOPE_ID}.bin

    if needs_rebuild; then build_script; fi

    exec_binary "$@"
}

main "$@"
