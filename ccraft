#!/usr/bin/env bash
# ccraft — run C files as scripts, with caching and shebang support
#
# WHAT IT DOES
# Compiles and executes C source files on the fly.
# Works as a shebang interpreter, so C files can be run directly like scripts.
# Caches compiled binaries in /tmp/ to avoid recompilation on subsequent runs,
# silent on cache hit, rebuilds only when source changes.
# Acts as both build tool and package manager: -R fetches remote header-only
# libraries via nugget, with annotations for declarative dependency lists.
#
# WHY
# C has no REPL. Header-only libraries make single-file programs viable, but
# the compile-run cycle adds friction. ccraft removes that friction: write C,
# run it, iterate. The shebang support means ./hello.c just works.
#
# USAGE
#   ccraft [CC_FLAG]... FILE.c [ARG]...
#   Everything after FILE.c is passed to the compiled binary.
#   #!/usr/bin/env -S ccraft  (as shebang; add flags after ccraft, e.g. -p libcurl)
#
# OPTIONS
#   -v          Show compilation command
#   -vv         Show compilation command and source code (rebuild only)
#   -std=STD    Override gnu99 as C standard
#   -o FILE     Write binary to FILE instead of /tmp/ cache
#   -p MODULE   Link against pkg-config MODULE, e.g. -p freetype2
#   -lLIB       Link library (compact form, e.g. -lm)
#   -R URL      Include from remote URL (fetched via nugget)
#               #include "nugget/<repo>/header.h" or "nugget/file.h"
#   ...         Any other CC/LD flags
#
#   // ccraft FLAGS...  annotation lines after shebang (additional flags)
#
# ENVIRONMENT
#   CC             Compiler (default: cc)
#   CCRAFT_CACHE   Cache strategy:
#     mtime (default) - Recompile when source is newer than binary (fastest)
#     md5             - Recompile when content hash changes (most correct)
#     none            - Always recompile (no cache)
#   TMPDIR         Temp directory (default: /tmp)
#
# EXAMPLES
#   ccraft hello.c
#   ccraft -lm calc.c "2 + 3"
#   ccraft -p SDL2 game.c
#   ccraft -R git+https://github.com/nothings/stb imgtool.c
#               // #include "nugget/stb/stb_image.h"
#   ccraft -R https://raw.githubusercontent.com/user/lib/helper.h use.c
#               // #include "nugget/helper.h"
#   cat hello.c | ccraft /dev/stdin
#
# DEPENDENCIES
#   cc (or $CC)
#   curl, if nugget not installed and -R used (auto-downloads nugget)
#   pkg-config, if -p used
#
# C99 Standard Headers, for reference:
#include <assert.h>
#include <complex.h>
#include <ctype.h>
#include <errno.h>
#include <fenv.h>
#include <float.h>
#include <inttypes.h>
#include <limits.h>
#include <stdint.h>
#include <locale.h>
#include <math.h>
#include <setjmp.h>
#include <signal.h>
#include <stdarg.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <tgmath.h>
#include <time.h>
#include <wchar.h>
#include <wctype.h>
#
# Additional headers:
#include <iso646.h>      /* see https://en.wikipedia.org/wiki/C_alternative_tokens */
#include <unistd.h>      /* POSIX system calls (fork, exec, read, write, etc.) */
#include <sys/types.h>   /* Basic system types (pid_t, size_t, off_t, etc.) */
#include <sys/stat.h>    /* File status and permissions */
#include <fcntl.h>       /* File control options */
#
set -e

# ============================================================================
# Helpers
# ============================================================================

SCRIPT=${0##*/}

die() { echo "${SCRIPT}: $*" >&2; exit 1; }
no()  { [[ -z $1 ]]; }

has_flag()        { [[ ${1:-} == -* ]]; }
is_stdin()        { [[ $FILE_C == "/dev/stdin" ]]; }
wants_trace()     { [[ $V_FLAG -ge 1 ]]; }
wants_source()    { [[ $V_FLAG -ge 2 ]]; }
binary_missing()  { [[ ! -x $OUT ]]; }
source_newer()    { [[ $FILE_C -nt $OUT ]]; }

fetch_remote_dep() {
    local URL=$1
    local NUGGET

    NUGGET=$(command -v nugget) || {
        NUGGET=${TMPDIR-/tmp}/ccraft-nugget
        command -v curl >/dev/null 2>&1 || die "curl required to download nugget"

        if wants_trace; then printf "+ fetched nugget\n" >&2; fi
        curl -fsSL -o "$NUGGET" \
            https://raw.githubusercontent.com/snoozelot/denim/master/screws/nugget
        chmod +x "$NUGGET"
    }

    mkdir -p "$NUGGET_DIR"
    if wants_trace; then printf "+ nugget %q\n" "$URL" >&2; fi

    "$NUGGET" -o "$NUGGET_DIR" "$URL" >/dev/null || die "nugget failed: $URL"
}

DISPATCH_CONSUMED=0
dispatch_flag() {
    DISPATCH_CONSUMED=0
    case $1 in
        -p)  read -ra CC_FLAGS_PKGCONFIG < <(pkg-config --cflags "$2")
             read -ra CC_LIBS_PKGCONFIG  < <(pkg-config --libs   "$2")
             CC_FLAGS_USER+=("${CC_FLAGS_PKGCONFIG[@]}"); LD_FLAGS_USER+=("${CC_LIBS_PKGCONFIG[@]}")
             DISPATCH_CONSUMED=1 ;;
        -p*) read -ra CC_FLAGS_PKGCONFIG < <(pkg-config --cflags "${1#-p}")
             read -ra CC_LIBS_PKGCONFIG  < <(pkg-config --libs   "${1#-p}")
             CC_FLAGS_USER+=("${CC_FLAGS_PKGCONFIG[@]}"); LD_FLAGS_USER+=("${CC_LIBS_PKGCONFIG[@]}") ;;
        -l*) LD_FLAGS_USER+=("$1") ;;
        -I)  CC_FLAGS_USER+=("-I$2"); DISPATCH_CONSUMED=1 ;;
        -I*) CC_FLAGS_USER+=("$1") ;;
        -R)  CC_REMOTE_DEPS+=("$2"); DISPATCH_CONSUMED=1 ;;
        -R*) CC_REMOTE_DEPS+=("${1#-R}") ;;
        -std=*) STD_FLAG=$1 ;;
        *)   CC_FLAGS_USER+=("$1") ;;
    esac
}

dispatch_line() {
    eval "set -- $1"

    while [[ $# -gt 0 ]]; do
        dispatch_flag "$1" "${2-}"
        shift $((1 + DISPATCH_CONSUMED))
    done
}

parse_annotations() {
    local FILE=$1

    while IFS= read -r LINE; do
        case $LINE in
            '// ccraft '*)
                dispatch_line "${LINE#*ccraft }" ;;
            '/* ccraft '*)
                local BODY=${LINE#*ccraft }
                dispatch_line "${BODY%\*/}" ;;
            '// ccompile '*)
                dispatch_line "${LINE#*ccompile }" ;;
            '/* ccompile '*)
                local BODY=${LINE#*ccompile }
                dispatch_line "${BODY%\*/}" ;;
            '//'*)  ;;
            '/*'*)  break ;;
            *)      break ;;
        esac
    done < <(tail -n +2 "$FILE")
}

scope_id() {
    case $CACHE_MODE in
        md5)   { id -u; cat "$1"; } | md5sum | head -c8 ;;
        mtime) { id -u; readlink -f "$1" 2>/dev/null || echo "$1"; } | md5sum | head -c8 ;;
        none)  { id -u; readlink -f "$1" 2>/dev/null || echo "$1"; } | md5sum | head -c8 ;;
    esac
}

needs_recompile() {
    case $CACHE_MODE in
        none)  return 0 ;;
        mtime) binary_missing || source_newer ;;
        md5)   binary_missing ;;
    esac
}

include_dir() {
    local REAL

    REAL=$(readlink -f "$FILE_C" 2>/dev/null || echo "$FILE_C")
    if [[ $FILE == "stdin" ]]; then pwd; else dirname "$REAL"; fi
}

# ============================================================================
# Usage
# ============================================================================

usage() {
    cat <<EOS
Usage: ${SCRIPT} [CC_FLAG]... FILE_C [ARG]...

Compile FILE_C and execute it with ARGs as arguments to the program.
Caches binary in /tmp/ — silent on hit, rebuilds when source changes.
Shebang: #!/usr/bin/env -S ${SCRIPT}
When FILE_C is /dev/stdin, cwd is added as compiler include path.
When FILE_C is a regular file, its directory is added as include path.

CC_FLAGs:
  -v          Show compilation command
  -vv         Show compilation command and source code (rebuild only)
  -std=STD    Override gnu99 as C standard with STD
  -o FILE     Write binary to FILE instead of /tmp/ cache
  -p MODULE   Link against pkg-config MODULE, e.g. -p freetype2
  -lLIB       Link library (compact form, e.g. -lm)
  -R URL      Include from remote URL via nugget
              #include "nugget/<repo>/header.h"
  ...         Any other CC/LD flags

Environment:
  CC            = ${CC-cc}
  CCRAFT_CACHE  = ${CCRAFT_CACHE-mtime}  (mtime|md5|none)
  TMPDIR        = /tmp (override for temp files)

Caching strategies:
  mtime   Recompile when source newer than binary (default, fastest)
  md5     Recompile when content hash changes (handles reverts correctly)
  none    Always recompile (no cache)

Examples:
  ${SCRIPT} -lm calc.c "2 + 3"
  ${SCRIPT} -vv -p SDL2 game.c
  ${SCRIPT} -R git+https://github.com/nothings/stb img.c
  cat hello.c | ${SCRIPT} -vv /dev/stdin

EOS
}

# ============================================================================
# Main
# ============================================================================

V_FLAG=0
STD_FLAG="-std=gnu99"
CC_FLAGS_USER=()
LD_FLAGS_USER=()
OUT=""
CLEANUP=()
CACHE_MODE=${CCRAFT_CACHE-mtime}
CC_REMOTE_DEPS=()

while has_flag "$1"; do
    case $1 in
        -v)     ((V_FLAG+=1));   shift   ;;
        -vv)    ((V_FLAG+=2));   shift   ;;
        -o)     OUT=$2;          shift 2 ;;
        -o*)    OUT=${1#-o};     shift   ;;
        -std=*) STD_FLAG=$1;     shift   ;;
        *)      dispatch_flag "$1" "${2-}"; shift $((1 + DISPATCH_CONSUMED)) ;;
    esac
done

[[ -r ${1:-} ]] || { usage; exit 1; }
FILE_C=$1; shift

if is_stdin; then
    FILE_C="${TMPDIR-/tmp}/ccraft-$$.c"
    cat > "$FILE_C"
    [[ -s $FILE_C ]] || die "stdin is empty"
    FILE="stdin"
else
    FILE=${FILE_C##*/}
    FILE=${FILE%.[ct]}
fi

SCOPE_ID=$(scope_id "$FILE_C")
STEM=${TMPDIR-/tmp}/ccraft-${SCOPE_ID}
STEM_D=${STEM}.d
NUGGET_DIR=${STEM_D}/nugget
TMP_C="${STEM_D}/src.c"

if [[ $FILE == "stdin" ]]; then
    mkdir -p "$STEM_D"
    mv "$FILE_C" "$TMP_C"
    FILE_C="/dev/stdin"
    CLEANUP+=("$STEM_D")
    trap 'rm -rf -- "${CLEANUP[@]}"' EXIT
fi

if no "$OUT"; then OUT=$STEM; fi

if needs_recompile; then
    mkdir -p "$STEM_D"
    CLEANUP+=("$STEM_D")
    if [[ $CACHE_MODE == "none" ]]; then CLEANUP+=("$OUT"); fi
    trap 'rm -rf -- "${CLEANUP[@]}"' EXIT

    if [[ $FILE != "stdin" ]]; then
        cp "$FILE_C" "$TMP_C"
    fi

    parse_annotations "$TMP_C"

    for URL in "${CC_REMOTE_DEPS[@]}"; do
        fetch_remote_dep "$URL"
    done
    [[ ${#CC_REMOTE_DEPS[@]} -gt 0 ]] && CC_FLAGS_USER+=("-I$STEM_D")
    sed -i "1 s|^#!.*|#line 2 \"$FILE_C\"|" "$TMP_C"

    if wants_source; then
        bat --language=C --number --paging=never "$TMP_C"  1>&2 2>/dev/null ||
        cat -vn "$TMP_C" 1>&2 2>/dev/null
    fi

    CC_FLAGS=(
        "$STD_FLAG"
        -O0 -pipe
        -I"$(include_dir)"
        -Wall -Wextra -Wno-unused
        -Wl,-O1
        "${CC_FLAGS_USER[@]}"
    )

    if wants_trace; then set -x; fi
    "${CC-cc}" "${CC_FLAGS[@]}" -o"$OUT" "$TMP_C" "${LD_FLAGS_USER[@]}" >&2
fi

{ set +x; } 2>/dev/null
if wants_trace; then set -x; fi
{ set +e; } 2>/dev/null

(exec -a "$FILE_C" "$OUT" "$@")
exit $?
