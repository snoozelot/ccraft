#!/usr/bin/env bash
# goon — discover and run Go projects from any subdirectory
#
# Walks up from DIR to find go.mod, finds the main() package,
# runs go mod tidy, builds, caches in /tmp/, runs.
# No need to remember ./cmd/server paths.
#
# WHY
# Monorepos have main() packages buried in subdirectories.
# goon finds them from anywhere in the module.
#
# USAGE
#   goon [-v] [-o FILE] DIR [ARG...]
#   goon -m FILE.go [ARG...]
#
# OPTIONS
#   -v        Show build commands
#   -m FILE   Build file as project entry point (finds go.mod)
#   -o FILE   Write binary to FILE instead of /tmp/ cache
#   -h        This help
#
# ENVIRONMENT
#   GO        Go toolchain (default: go)
#   GOON_CACHE mtime (default: source newer than binary),
#              md5 (content hash), none (always rebuild)
#   TMPDIR    Temp dir (default: /tmp)
#
# EXAMPLES
#   goon .
#   goon -v .
#   goon ./cmd/server
#   goon -m main.go
#   goon -o /tmp/myapp .
#
# EXIT CODES
#   0       Program ran successfully
#   1       Usage error, no main package found, or project error
#   *       Exit code from the executed binary
#
# DEPENDENCIES
#   go (or $GO)
#   git (for walking up from subdirectory)
#
# NOTES
#   Unknown flags are passed through to go build, e.g.
#   goon -ldflags="-s -w" .

set -e

SCRIPT=${0##*/}
die()    { echo "$SCRIPT: $*" >&2; exit 1; }
in_dir() ( DIR=$1; shift; cd "$DIR" && "$@" )
got()    { [[ -n $1 ]]; }
has_binary()  { [[ -x "$OUT" ]]; }
has_go_mod()  { [[ -f "$1"/go.mod ]]; }
has_m_flag()  { [[ $M_FLAG -eq 1 ]]; }
is_verbose()  { (( V_FLAG >= 1 )); }
is_at_root()  { [[ $PKG_DIR == "$MODROOT" ]]; }

trace()   { if is_verbose; then set -x; "$@"; { set +x; } 2>/dev/null; else "$@"; fi; }

quiet() {
    if is_verbose; then trace "$@"; else
        local CAPTURED STATUS
        CAPTURED=$("$@" 2>&1); STATUS=$?
        if (( STATUS != 0 )); then echo "+ $*" >&2; echo "$CAPTURED" >&2; fi
        return "$STATUS"
    fi
}

usage() { sed -n '2,/^[^#]/ { s/^# \?//p }' "$0"; exit 0; }

# ============================================================================
# Module discovery
# ============================================================================

# Walk up from DIR to find go.mod (stops at git root or /).
find_modroot() {
    local DIR=$1 TARGET_GIT_ROOT
    TARGET_GIT_ROOT=$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null) || TARGET_GIT_ROOT=
    while [[ $DIR != "/" ]]; do
        if has_go_mod "$DIR"; then echo "$DIR"; return 0; fi
        if got "$TARGET_GIT_ROOT" && [[ $DIR == "$TARGET_GIT_ROOT" ]]; then break; fi
        DIR=$(dirname "$DIR")
    done
    return 1
}

die_ambiguous() {
    local MODROOT=$1 SCOPE=$2; shift 2
    echo "multiple entry points in $SCOPE:" >&2
    for dir; do echo "  ${dir#"$MODROOT"/}" >&2; done
    exit 1
}

# List all main() packages in the module. Die if zero or multiple.
list_main_packages() {
    local MODROOT
    local ENTRIES
    local BASE

    MODROOT=$1
    BASE=$(basename "$MODROOT")
    ENTRIES=$(
        in_dir "$MODROOT" "${GO-go}" list -buildvcs=false \
            -f '{{if eq .Name "main"}}{{.Dir}}{{end}}' ./... 2>/dev/null
    )
    got "$ENTRIES" || die "no main packages in $BASE"
    echo "$ENTRIES"
}

# From a list of main packages, pick one. Die if multiple.
pick_main() {
    local MODROOT=$1 SCOPE=$2; shift 2
    if [[ $# -eq 1 ]]; then echo "$1"; return 0; fi
    die_ambiguous "$MODROOT" "$SCOPE" "$@"
}

# Find the main package under DIR within MODROOT.
# First checks if DIR itself is main, then searches subdirectories.
main_under_dir() {
    local MODROOT=$1 DIR=$2 REL ENTRIES
    REL="${DIR#"$MODROOT"/}"

    if in_dir "$MODROOT" "${GO-go}" list -buildvcs=false \
        -f '{{.Name}}' "./$REL" 2>/dev/null | grep -q '^main$'; then
        echo "$DIR"; return 0
    fi

    ENTRIES=$(
        in_dir "$MODROOT" "${GO-go}" list -buildvcs=false \
            -f '{{if eq .Name "main"}}{{.Dir}}{{end}}' "./$REL/..." 2>/dev/null
    )
    got "$ENTRIES" || die "no main packages in $REL"
    pick_main "$MODROOT" "$REL" $ENTRIES
}

# ============================================================================
# Cache helpers
# ============================================================================

# SIDEFF: sets ALL_GO_FILES for cache_key and needs_rebuild
collect_go_files() {
    ALL_GO_FILES=()
    while IFS= read -r -d '' f; do
        ALL_GO_FILES+=("$f")
    done < <(find "$1" -name '*.go' -not -path '*/vendor/*' -xtype f -print0 2>/dev/null | sort -z)
}

cache_key() {
    local FILES=("${ALL_GO_FILES[@]}")
    case ${CACHE_MODE:=mtime} in
        md5) { id -u; for f in "${FILES[@]}"; do cat "$f"; done; } ;;
        *)   { id -u; for f in "${FILES[@]}"; do echo "$f"; done; } ;;
    esac | md5sum | head -c8
}

needs_rebuild() {
    if ! has_binary; then return 0; fi
    case $CACHE_MODE in
        none)  return 0 ;;
        md5)   [[ $(cache_key) != "$SCOPE_ID" ]] ;;
        mtime)
            for f in "${ALL_GO_FILES[@]}"; do
                [[ "$f" -nt "$OUT" ]] && return 0
            done
            return 1 ;;
    esac
}

cache_name() {
    # SIDEFF: sets FILE for main() to use in OUT path
    local BASE
    BASE=$(basename "$1")
    if is_at_root; then FILE="proj-$BASE"
    else
        local REL="${2#"$1"/}"
        FILE="proj-$BASE-${REL//\//-}"
    fi
}

# ============================================================================
main() {
    local TARGET
    local V_FLAG
    local M_FLAG
    local GO_FLAGS_USER
    local OUT
    local CACHE_MODE
    local ALL_GO_FILES
    local MODROOT
    local PKG_DIR
    local FILE
    local SCOPE_ID

    V_FLAG=0
    M_FLAG=0
    GO_FLAGS_USER=()
    OUT=""
    ALL_GO_FILES=()
    MODROOT=
    PKG_DIR=
    FILE=
    SCOPE_ID=
    CACHE_MODE=${GOON_CACHE:-mtime}

    while [[ ${1:-} == -* ]]; do
        case $1 in
            -v)   ((V_FLAG+=1)); shift ;;
            -o)   OUT=$2; shift 2 ;;
            -o*)  OUT=${1#-o}; shift ;;
            -m)   M_FLAG=1; shift ;;
            -h|--help) usage ;;
            *)    GO_FLAGS_USER+=("$1"); shift ;;
        esac
    done

    TARGET=$1; shift 2>/dev/null || :
    got "$TARGET" || usage

    # Resolve target → MODROOT + PKG_DIR
    local TARGET_DIR
    if [[ -d "$TARGET" ]]; then
        TARGET_DIR=$(cd "$TARGET" && pwd) || die "cannot resolve $TARGET"
        MODROOT=$(find_modroot "$TARGET_DIR") || die "no go.mod from $TARGET up to git root or /"
        if [[ $TARGET_DIR == "$MODROOT" ]]; then
            PKG_DIR=$(pick_main "$MODROOT" "$(basename "$MODROOT")" $(list_main_packages "$MODROOT"))
        else
            PKG_DIR=$(main_under_dir "$MODROOT" "$TARGET_DIR")
        fi
    elif has_m_flag && [[ -f "$TARGET" ]]; then
        TARGET_DIR=$(dirname "$(readlink -f "$TARGET")") || die "cannot resolve $TARGET"
        MODROOT=$(find_modroot "$TARGET_DIR") || die "no go.mod from $TARGET_DIR up to git root or /"
        PKG_DIR=$TARGET_DIR
    else
        die "$TARGET: not a directory (use -m for a file entry point)"
    fi

    cache_name "$MODROOT" "$PKG_DIR"
    collect_go_files "$MODROOT"

    SCOPE_ID=$(cache_key)
    OUT=${OUT:-${TMPDIR-/tmp}/goon-${FILE}-${SCOPE_ID}.bin}

    if needs_rebuild; then
        local REL_PATH
        if is_at_root; then REL_PATH="."
        else REL_PATH="${PKG_DIR#"$MODROOT"/}"
        fi
        in_dir "$MODROOT" quiet "${GO-go}" mod tidy
        in_dir "$MODROOT" trace "${GO-go}" build -buildvcs=false \
            "${GO_FLAGS_USER[@]}" -o "$OUT" "./$REL_PATH"
    fi

    # Execute — errexit off so exec returns binary's status
    { set +x; } 2>/dev/null
    if is_verbose; then set -x; fi
    { set +e; } 2>/dev/null
    (exec -a "$TARGET" "$OUT" "$@")
    exit $?
}

main "$@"
